# 앱 설정
PROJECT_NAME=capstone-api
DEBUG=true

# CORS 허용 origin 
CORS_ORIGINS=http://localhost:5173

# MySQL 접속 정보
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DB=capstone

# JWT 
JWT_SECRET=change-me-to-a-long-random-secret
# 액세스 토큰 만료(분)
JWT_EXPIRE_MINUTES=10080
