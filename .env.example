# 앱 설정
PROJECT_NAME=capstone-api
DEBUG=true

# CORS 허용 origin
CORS_ORIGINS=
# 로컬 dev origin 정규식 
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# MySQL 접속 정보
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DB=capstone

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
# 액세스 토큰 만료(분)
JWT_EXPIRE_MINUTES=10080

# OpenAI
OPENAI_API_KEY=sk-...
